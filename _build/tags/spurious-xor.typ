// Macros for notes/Spurious-XOR (LaBonte & Muthukumar, "SGD Provably
// Prioritizes a Shortcut Spurious Feature in the XOR Model"), carried over
// from typst/Spurious_Notes.typ. Notes use them with `tags: [spurious-xor]`.
#let bw = $bold(w)$
#let bx = $bold(x)$
#let bz = $bold(z)$
#let bs = $bold(s)$
#let bxi = $bold(xi)$
#let smaj = $bold(s)_"maj"$
#let smin = $bold(s)_"min"$
// weight components: vectors, and the scalar spurious weight w_sp
#let wsig = $bold(w)_"sig"$
#let wopp = $bold(w)_"opp"$
#let wsp = $bold(w)_"sp"$
#let wsps = $w_"sp"$
#let e3 = $bold(e)_3$
// x and xi without coordinate i
#let xnoi = $bold(x)_(without i)$
#let xinoi = $bold(xi)_(without i)$
#let grad = $gradient$
#let leqa = $lt.tilde$
